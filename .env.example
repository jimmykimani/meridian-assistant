# Local secrets — copy to `.env` and fill in. Never commit `.env`.

GROQ_API_KEY=
# Optional; default llama-3.1-8b-instant (fast production default). Heavier: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile
# Retries for Groq 429 (defaults: 6 attempts, 1.5s base backoff).
# GROQ_COMPLETION_RETRIES=8
# GROQ_RETRY_BASE_SEC=2
# Cap MCP tool payload size per Groq round (default 10000; lower if you still see HTTP 413).
# MAX_TOOL_RESULT_CHARS=8000
# Cap each prior assistant message when building Groq context (default 8000).
# MAX_ASSISTANT_CHARS_IN_CONTEXT=6000
# Full-catalog bypass display cap (default 250000).
# MERIDIAN_CATALOG_RESPONSE_MAX_CHARS=120000

# Streamlit: set to true to show API base URL in a Developer expander (default hidden in the UI).
# MERIDIAN_SHOW_API_URL=true

# Optional MCP server (Streamable HTTP). Leave empty to exercise agent without tools until configured.
# MCP_SERVER_URL=

# Optional LangSmith (https://smith.langchain.com/) — never commit real keys; use host secrets only.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=meridian-support
# Legacy names also work: LANGCHAIN_TRACING_V2=true, LANGCHAIN_API_KEY=
