# Local secrets — copy to `.env` and fill in. Never commit `.env`.

GROQ_API_KEY=
# Optional; default llama-3.1-8b-instant (lightest common Groq chat + tools). For quality: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile
# Retries for Groq 429 (defaults: 6 attempts, 1.5s base backoff).
# GROQ_COMPLETION_RETRIES=8
# GROQ_RETRY_BASE_SEC=2
# Cap MCP tool payload size per Groq round (default 5000; lower if you still see HTTP 413).
# MAX_TOOL_RESULT_CHARS=4000

# Optional MCP server (Streamable HTTP). Leave empty to exercise agent without tools until configured.
# MCP_SERVER_URL=

# Optional LangSmith (https://smith.langchain.com/) — never commit real keys; use host secrets only.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=meridian-support
# Legacy names also work: LANGCHAIN_TRACING_V2=true, LANGCHAIN_API_KEY=
